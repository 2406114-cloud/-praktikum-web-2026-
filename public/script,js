// Logika Client-Side JavaScript CRUD
// Modul 7 - Praktikum Pemrograman Web
// ==========================================

document.addEventListener("DOMContentLoaded", () => {

    // 1. Tangkap Elemen DOM
    const mhsForm = document.querySelector("#mhsForm");
    const mhsIdInput = document.querySelector("#mhsId");
    const nimInput = document.querySelector("#nim");
    const namaInput = document.querySelector("#nama");
    const jurusanInput = document.querySelector("#jurusan");
    const emailInput = document.querySelector("#email");

    const btnSubmit = document.querySelector("#btnSubmit");
    const btnCancel = document.querySelector("#btnCancel");
    const formTitle = document.querySelector("#formTitle");

    const mhsTableBody = document.querySelector("#mhsTableBody");
    const alertMessage = document.querySelector("#alertMessage");

    // Menyimpan daftar mahasiswa
    let listMahasiswa = [];

    // ==========================================
    // 2. Fungsi Pembantu Notifikasi Alert
    // ==========================================

    const showAlert = (text, type = "success") => {
        alertMessage.textContent = text;
        alertMessage.className = `alert alert-${type}`;
        alertMessage.style.display = "block";

        setTimeout(() => {
            alertMessage.style.display = "none";
        }, 3000);
    };

    // ==========================================
    // 3. READ: Mengambil Data Mahasiswa dari API
    // ==========================================

    const loadMahasiswa = async () => {
        try {
            const res = await fetch("/api/mahasiswa");

            listMahasiswa = await res.json();

            renderTable(listMahasiswa);

        } catch (err) {
            showAlert(
                "Gagal memuat data dari server backend",
                "error"
            );
        }
    };

    // ==========================================
    // 4. Menampilkan Data ke Tabel HTML
    // ==========================================

    const renderTable = (data) => {

        mhsTableBody.innerHTML = "";

        if (data.length === 0) {
            mhsTableBody.innerHTML = `
                <tr>
                    <td colspan="6"
                        style="text-align:center; color:#64748b;">
                        Belum ada data mahasiswa tersimpan.
                    </td>
                </tr>
            `;

            return;
        }

        data.forEach((mhs, idx) => {

            const tr = document.createElement("tr");

            tr.innerHTML = `
                <td>${idx + 1}</td>
                <td>${mhs.nim}</td>
                <td>${mhs.nama}</td>
                <td>${mhs.jurusan}</td>
                <td>${mhs.email}</td>
                <td>
                    <button
                        class="btn-action btn-edit"
                        data-id="${mhs.id}">
                        Edit
                    </button>

                    <button
                        class="btn-action btn-delete"
                        data-id="${mhs.id}">
                        Hapus
                    </button>
                </td>
            `;

            mhsTableBody.appendChild(tr);
        });
    };

    // ==========================================
    // 5. CREATE & UPDATE: Submit Formulir
    // ==========================================

    mhsForm.addEventListener("submit", async (e) => {

        // Mencegah halaman melakukan reload
        e.preventDefault();

        // Mengambil data dari formulir
        const payload = {
            nim: nimInput.value.trim(),
            nama: namaInput.value.trim(),
            jurusan: jurusanInput.value,
            email: emailInput.value.trim()
        };

        // Memeriksa apakah sedang dalam mode edit
        const id = mhsIdInput.value;
        const isEdit = Boolean(id);

// Validasi NIM duplikat menggunakan .some()
        const nimDuplikat = listMahasiswa.some((mhs) =>
            String(mhs.nim).toLowerCase() === payload.nim.toLowerCase()
            && (!isEdit || Number(mhs.id) !== Number(id))
        );

        // Jika NIM sudah digunakan mahasiswa lain
        if (nimDuplikat) {
            showAlert("NIM sudah terdaftar!", "error");
            return;
        }


        // Menentukan URL dan HTTP Method
        const url = isEdit
            ? `/api/mahasiswa/${id}`
            : "/api/mahasiswa";

        const method = isEdit ? "PUT" : "POST";

        try {

            // Mengirim data ke backend
            const res = await fetch(url, {
                method: method,
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(payload)
            });

            const result = await res.json();

            if (result.success) {

                showAlert(result.message);

                resetForm();

                loadMahasiswa();

            } else {

                showAlert(
                    "Terjadi kesalahan: " + result.message,
                    "error"
                );
            }

        } catch (err) {

            showAlert(
                "Gagal mengirim data ke server",
                "error"
            );

        }
    });

    // ==========================================
    // 6. DELETE & EDIT: Event Delegation
    // ==========================================

    mhsTableBody.addEventListener("click", async (e) => {

        const id = Number(e.target.dataset.id);

        if (!id) return;

        // --------------------------------------
        // MODE EDIT
        // --------------------------------------

        if (e.target.classList.contains("btn-edit")) {

            const targetMhs = listMahasiswa.find(
                m => m.id === id
            );

            if (targetMhs) {

                // Mengisi formulir secara otomatis
                mhsIdInput.value = targetMhs.id;
                nimInput.value = targetMhs.nim;
                namaInput.value = targetMhs.nama;
                jurusanInput.value = targetMhs.jurusan;
                emailInput.value = targetMhs.email;

                // Mengubah tampilan menjadi mode edit
                formTitle.textContent = "Edit Data Mahasiswa";

                btnSubmit.textContent = "Perbarui Mahasiswa";

                btnCancel.style.display = "inline-block";

                // Kembali ke bagian atas halaman
                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });
            }

        }

        // --------------------------------------
        // MODE DELETE
        // --------------------------------------

        else if (e.target.classList.contains("btn-delete")) {

            if (confirm(
                "Apakah Anda yakin ingin menghapus data mahasiswa ini?"
            )) {

                try {

                    const res = await fetch(
                        `/api/mahasiswa/${id}`,
                        {
                            method: "DELETE"
                        }
                    );

                    const result = await res.json();

                    if (result.success) {

                        showAlert(result.message);

                        loadMahasiswa();

                    }

                } catch (err) {

                    showAlert(
                        "Gagal menghapus data dari server",
                        "error"
                    );

                }
            }
        }
    });

    // ==========================================
    // 7. Reset Form ke Mode Tambah
    // ==========================================

    const resetForm = () => {

        mhsForm.reset();

        mhsIdInput.value = "";

        formTitle.textContent = "Tambah Mahasiswa Baru";

        btnSubmit.textContent = "Simpan Mahasiswa";

        btnCancel.style.display = "none";
    };

    // Tombol Batal Edit
    btnCancel.addEventListener("click", resetForm);

    // ==========================================
    // 8. Mengambil Data Saat Halaman Dibuka
    // ==========================================

    loadMahasiswa();

});

